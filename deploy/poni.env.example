# Settings for deploy/docker-compose.prod.yml. Copy to /etc/poni-gbp/poni.env
# on the server (owner root, mode 600) and fill in. The real file holds
# secrets: it never goes into the repository.

# The dashboard's host name, without https://. Its DNS record must point at the server.
PONI_SITE_ADDRESS=

# Where the images come from, e.g. us-docker.pkg.dev/xvisionmedia-gbp/poni/poni-gbp,
# and which build to run (deploy/build-images.sh prints both).
PONI_IMAGE_PREFIX=
PONI_IMAGE_TAG=
# The web image is built in the dashboard repository; its tag, when it is not PONI_IMAGE_TAG.
PONI_WEB_IMAGE_TAG=

# PostgreSQL password. Letters and digits only (it is used inside a URL):
#   openssl rand -hex 24
PONI_DB_PASSWORD=

# Encrypts the stored GBP token. Losing it means signing in to GBP again;
# leaking it together with the database exposes the token.
#   openssl rand -base64 32
PONI_SECRET_KEY=

# Google OAuth web client for staff sign-in (see deploy/README.md, "Google sign-in").
PONI_GOOGLE_SIGNIN_CLIENT_ID=
PONI_GOOGLE_SIGNIN_CLIENT_SECRET=
# Google Workspace domains whose accounts may sign in, comma-separated.
PONI_SIGNIN_DOMAINS=xvisionmediaus.com,xvisionus.com

# Google OAuth client of the "PONI GBP Manager" app, used by the "Connect"
# buttons of the dashboard's status page (the GBP managing account and the
# sending mailbox).
PONI_GBP_OAUTH_CLIENT_ID=
PONI_GBP_OAUTH_CLIENT_SECRET=

# Review notifications. Leave empty to rely on polling alone.
PONI_PUBSUB_SUBSCRIPTION=projects/xvisionmedia-gbp/subscriptions/gbp-notifications-engine

# The model providers that analyze reviews and draft replies (nothing is
# posted without a person's approval or a switched-on location). One pair per
# provider: an OpenAI-compatible address up to the version segment, and its
# key, for example
# https://<region host>/compatible-mode/v1 for DashScope. A DashScope key only
# works with the address of its own region (D-010). Which provider each task
# uses is chosen in the dashboard (Analysis settings). All empty: reviews are
# synced but not analyzed.
# Every provider also says which API it speaks, PONI_LLM_<NAME>_PROTOCOL:
# openai (any OpenAI-compatible provider) or anthropic (Anthropic's Messages
# API). The engine refuses to start if a provider that has an address and a
# key has no protocol.
# Another provider is three more lines here (PONI_LLM_<NAME>_BASE_URL,
# _API_KEY and _PROTOCOL) and the same three in docker-compose.prod.yml.
PONI_LLM_DASHSCOPE_BASE_URL=
PONI_LLM_DASHSCOPE_API_KEY=
PONI_LLM_DASHSCOPE_PROTOCOL=openai
PONI_LLM_OPENAI_BASE_URL=
PONI_LLM_OPENAI_API_KEY=
PONI_LLM_OPENAI_PROTOCOL=openai
# The judge of the go-live test (D-074), which a client's configuration must
# pass before anything is auto-posted with it: https://api.anthropic.com/v1
# and a key.
PONI_LLM_ANTHROPIC_BASE_URL=
PONI_LLM_ANTHROPIC_API_KEY=
PONI_LLM_ANTHROPIC_PROTOCOL=anthropic

# The knowledge base (industry packs, voice templates, defaults, model
# prices): the Cloud Storage bucket archives are published to (name only, no
# gs://) and the archive this installation runs on, as `poni-tools publish`
# printed it. The VM's service account needs to read the bucket. To update:
# change the archive's name here and run the seed service (deploy/README.md).
PONI_KNOWLEDGE_BUCKET=
PONI_KNOWLEDGE_ARCHIVE=

# Reports (D-085, D-104). PONI_PUBLIC_BUCKET: the Cloud Storage bucket the
# pages of reports and the media of local posts are put in (name only, no
# gs://). Anyone who has a page's address can read it and nobody can list the
# bucket. It has no lifecycle rule: the retention is our own (deploy/README.md).
# Without it, no report is built and no photo or video can be uploaded for a post.
# Caddy reads it too: the site's Content-Security-Policy names this bucket as
# the one address the dashboard may frame (a report's page). Restart the stack
# after changing it.
PONI_PUBLIC_BUCKET=

# Push to the phone app (D-097): all five or none. The environment is
# production for builds from TestFlight and the App Store. The key is the
# APNs auth key's .p8 file without its BEGIN and END lines, on one line
# (grep -v -- ----- AuthKey_XXXXXXXXXX.p8 | tr -d '\n'); it is a secret.
# Without them nothing is pushed and push rules are refused.
PONI_APNS_ENVIRONMENT=
PONI_APNS_KEY=
PONI_APNS_KEY_ID=
PONI_APNS_TEAM_ID=
PONI_APNS_BUNDLE_ID=

# Nightly backup: time of day in UTC, days to keep local copies, and the
# Cloud Storage bucket for the off-server copy (name only, no gs://).
PONI_BACKUP_TIME_UTC=08:30
PONI_BACKUP_KEEP_DAYS=14
PONI_BACKUP_BUCKET=
