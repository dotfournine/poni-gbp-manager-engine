{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "PONI_WERROR": "ON"
      }
    },
    {
      "name": "macos-llvm",
      "displayName": "macOS arm64, Homebrew LLVM",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-brewllvm",
        "VCPKG_HOST_TRIPLET": "arm64-osx-brewllvm",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/brew-llvm.cmake"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux, Clang (container image)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "$env{PONI_VCPKG_ARCH}-linux-clang",
        "VCPKG_HOST_TRIPLET": "$env{PONI_VCPKG_ARCH}-linux-clang",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/linux-clang.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-llvm",
      "configurePreset": "macos-llvm"
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang"
    }
  ],
  "testPresets": [
    {
      "name": "macos-llvm",
      "configurePreset": "macos-llvm",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
