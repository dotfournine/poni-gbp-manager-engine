{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poni-gbp.invalid/knowledge/corpus.schema.json",
  "title": "knowledge/industries/<key>/corpus.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$",
            "maxLength": 40
          },
          "category": {
            "enum": [
              "severity",
              "manipulation",
              "control"
            ]
          },
          "stars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "lang": {
            "enum": [
              "en",
              "zh",
              "zh-Hant",
              "es",
              "mixed"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "severity_any": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 60
                },
                "description": "At least one of these flags must be raised."
              },
              "manipulation": {
                "type": "boolean"
              },
              "action": {
                "enum": [
                  "auto_reply",
                  "approval_queue",
                  "escalate"
                ],
                "description": "The route the gate must give when the models behave."
              }
            },
            "required": [
              "manipulation",
              "action"
            ]
          }
        },
        "required": [
          "category",
          "expect",
          "id",
          "lang",
          "stars",
          "text"
        ]
      }
    }
  },
  "required": [
    "cases"
  ]
}
