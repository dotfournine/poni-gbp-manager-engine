{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poni-gbp.invalid/knowledge/profile.schema.json",
  "title": "knowledge/industries/<key>/profile.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 60
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 60
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "label"
        ]
      }
    },
    "item_types": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "person": {
            "description": "True: an item of this type is a staff member a reviewer named. Such items are listed in the report's employee recognition section, not among the items. The analyzer is not told this flag.",
            "type": "boolean"
          }
        },
        "required": [
          "description",
          "id"
        ]
      }
    },
    "severity_flags": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/flag"
      }
    }
  },
  "required": [
    "item_types",
    "key",
    "label",
    "severity_flags",
    "topics"
  ],
  "$defs": {
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 60
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "enabled",
        "id",
        "label"
      ]
    }
  }
}
