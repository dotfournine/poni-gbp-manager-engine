{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poni-gbp.invalid/knowledge/settings.schema.json",
  "title": "Content and reply settings: a layer holds any of the fields, a complete set holds all",
  "$defs": {
    "lengthRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        }
      },
      "required": [
        "max",
        "min"
      ]
    },
    "lengthLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rating_only": {
          "$ref": "#/$defs/lengthRange"
        },
        "positive": {
          "$ref": "#/$defs/lengthRange"
        },
        "complaint": {
          "$ref": "#/$defs/lengthRange"
        },
        "severity": {
          "$ref": "#/$defs/lengthRange"
        }
      },
      "required": [
        "complaint",
        "positive",
        "rating_only",
        "severity"
      ]
    },
    "contentLayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_facts": {
          "type": "string",
          "maxLength": 2000
        },
        "base_style": {
          "type": "string",
          "maxLength": 2000
        },
        "emoji_allowed": {
          "type": "boolean"
        },
        "emoji_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "emoji_preferred": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "words_to_avoid": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "style_notes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "chinese_variant": {
          "enum": [
            "zh-CN",
            "zh-HK",
            "zh-TW",
            null
          ]
        },
        "english_variant": {
          "enum": [
            "en-US",
            "en-CA",
            null
          ]
        },
        "audience": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": []
    },
    "content": {
      "allOf": [
        {
          "$ref": "#/$defs/contentLayer"
        },
        {
          "required": [
            "audience",
            "base_style",
            "business_facts",
            "chinese_variant",
            "emoji_allowed",
            "emoji_max",
            "emoji_preferred",
            "english_variant",
            "style_notes",
            "words_to_avoid"
          ]
        }
      ]
    },
    "replyLayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reply_languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "en",
              "zh",
              "es"
            ]
          }
        },
        "fallback_language": {
          "enum": [
            "en",
            "zh",
            "es"
          ]
        },
        "signature": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\r\\n]*$"
        },
        "sign_off_name": {
          "type": "string",
          "maxLength": 200
        },
        "length": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "en": {
              "$ref": "#/$defs/lengthLimits"
            },
            "zh": {
              "$ref": "#/$defs/lengthLimits"
            },
            "es": {
              "$ref": "#/$defs/lengthLimits"
            }
          }
        },
        "example_replies": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "promos_allowed": {
          "type": "boolean"
        },
        "contact_allowed": {
          "type": "boolean"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "auto_reply_positive": {
          "type": "boolean"
        },
        "auto_reply_rating_only": {
          "type": "boolean"
        },
        "auto_reply_min_stars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "auto_reply_delay_min_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "auto_reply_delay_max_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "auto_reply_window_start": {
          "type": "string",
          "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9])?$"
        },
        "auto_reply_window_end": {
          "type": "string",
          "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9])?$"
        }
      },
      "required": []
    },
    "reply": {
      "allOf": [
        {
          "$ref": "#/$defs/replyLayer"
        },
        {
          "required": [
            "auto_reply_delay_max_minutes",
            "auto_reply_delay_min_minutes",
            "auto_reply_min_stars",
            "auto_reply_positive",
            "auto_reply_rating_only",
            "auto_reply_window_end",
            "auto_reply_window_start",
            "contact_allowed",
            "example_replies",
            "fallback_language",
            "length",
            "promos_allowed",
            "reply_languages",
            "sign_off_name",
            "signature",
            "temperature"
          ]
        }
      ]
    }
  }
}
