{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poni-gbp.invalid/knowledge/settings.schema.json",
  "title": "Voice, localization and policy: a layer holds any of the fields, a complete set holds all",
  "$defs": {
    "lengthRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        }
      },
      "required": [
        "max",
        "min"
      ]
    },
    "lengthLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rating_only": {
          "$ref": "#/$defs/lengthRange"
        },
        "positive": {
          "$ref": "#/$defs/lengthRange"
        },
        "complaint": {
          "$ref": "#/$defs/lengthRange"
        },
        "severity": {
          "$ref": "#/$defs/lengthRange"
        }
      },
      "required": [
        "complaint",
        "positive",
        "rating_only",
        "severity"
      ]
    },
    "voiceLayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reply_name": {
          "type": "string",
          "maxLength": 200
        },
        "business_facts": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "sign_off": {
          "type": "string",
          "maxLength": 200
        },
        "owner_name": {
          "type": "string",
          "maxLength": 200
        },
        "emoji": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "preferred": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "required": []
        },
        "promos_allowed": {
          "type": "boolean"
        },
        "contact_allowed": {
          "type": "boolean"
        },
        "words_to_avoid": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "length": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "en": {
              "$ref": "#/$defs/lengthLimits"
            },
            "zh": {
              "$ref": "#/$defs/lengthLimits"
            },
            "es": {
              "$ref": "#/$defs/lengthLimits"
            }
          }
        },
        "style_notes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "example_replies": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "base_style": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": []
    },
    "voice": {
      "allOf": [
        {
          "$ref": "#/$defs/voiceLayer"
        },
        {
          "required": [
            "base_style",
            "business_facts",
            "contact_allowed",
            "emoji",
            "example_replies",
            "length",
            "owner_name",
            "promos_allowed",
            "reply_name",
            "sign_off",
            "style_notes",
            "temperature",
            "words_to_avoid"
          ]
        }
      ]
    },
    "localizationLayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reply_languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "en",
              "zh",
              "es"
            ]
          }
        },
        "chinese_script": {
          "enum": [
            "match",
            "simplified",
            "traditional"
          ]
        },
        "chinese_region": {
          "enum": [
            "mainland",
            "taiwan",
            "hong_kong"
          ]
        },
        "english_variant": {
          "enum": [
            "us",
            "ca"
          ]
        },
        "fallback_language": {
          "enum": [
            "en",
            "zh",
            "es"
          ]
        }
      },
      "required": []
    },
    "localization": {
      "allOf": [
        {
          "$ref": "#/$defs/localizationLayer"
        },
        {
          "required": [
            "chinese_region",
            "chinese_script",
            "english_variant",
            "fallback_language",
            "reply_languages"
          ]
        }
      ]
    },
    "policyLayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_post_positive": {
          "type": "boolean"
        },
        "auto_post_rating_only": {
          "type": "boolean"
        },
        "auto_post_min_stars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "auto_post_delay_min_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "auto_post_delay_max_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "auto_post_window_start": {
          "type": "string",
          "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9])?$"
        },
        "auto_post_window_end": {
          "type": "string",
          "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9])?$"
        }
      },
      "required": []
    },
    "policy": {
      "allOf": [
        {
          "$ref": "#/$defs/policyLayer"
        },
        {
          "required": [
            "auto_post_delay_max_minutes",
            "auto_post_delay_min_minutes",
            "auto_post_min_stars",
            "auto_post_positive",
            "auto_post_rating_only",
            "auto_post_window_end",
            "auto_post_window_start"
          ]
        }
      ]
    }
  }
}
